#: frappe/core/page/permission_manager/permission_manager_help.html:52
msgid "Allows printing or PDF download of documents."
msgstr "Leidžia spausdinti arba atsisiųsti dokumentus PDF formatu."

#: frappe/core/page/permission_manager/permission_manager_help.html:77
msgid "Allows sharing document access with other users."
msgstr "Leidžia dalytis prieiga prie dokumentų su kitais vartotojais."

#. Description of the 'Skip Authorization' (Check) field in DocType 'OAuth
#. Settings'
#: frappe/integrations/doctype/oauth_settings/oauth_settings.json:100
msgid "Allows skipping authorization if a user has active tokens."
msgstr "Leidžia praleisti autorizaciją, jei naudotojas turi aktyvių žetonų."

#: frappe/core/page/permission_manager/permission_manager_help.html:62
#: frappe/public/js/frappe/ui/permission_dialog.js:52
msgid "Allows the user to access reports related to the document."
msgstr "Leidžia vartotojui pasiekti su dokumentu susijusias ataskaitas."

#: frappe/public/js/frappe/ui/permission_dialog.js:31
msgid "Allows the user to amend a cancelled document into a new copy."
msgstr "Leidžia vartotojui pakeisti atšauktą dokumentą į naują kopiją."

#: frappe/public/js/frappe/ui/permission_dialog.js:28
msgid "Allows the user to cancel submitted documents."
msgstr "Leidžia vartotojui atšaukti pateiktus dokumentus."

#: frappe/core/page/permission_manager/permission_manager_help.html:42
#: frappe/public/js/frappe/ui/permission_dialog.js:22
msgid "Allows the user to create new documents."
msgstr "Leidžia vartotojui kurti naujus dokumentus."

#: frappe/core/page/permission_manager/permission_manager_help.html:47
#: frappe/public/js/frappe/ui/permission_dialog.js:23
msgid "Allows the user to delete documents."
msgstr "Leidžia vartotojui ištrinti dokumentus."

#: frappe/core/page/permission_manager/permission_manager_help.html:37
#: frappe/public/js/frappe/ui/permission_dialog.js:20
msgid "Allows the user to edit existing records they have access to."
msgstr "Leidžia vartotojui redaguoti esamus įrašus, prie kurių jis turi prieigą."

#: frappe/core/page/permission_manager/permission_manager_help.html:57
msgid "Allows the user to email from the document."
msgstr "Leidžia vartotojui siųsti el. laiškus iš dokumento."

#: frappe/core/page/permission_manager/permission_manager_help.html:67
msgid "Allows the user to export data from the Report view."
msgstr "Leidžia vartotojui eksportuoti duomenis iš ataskaitos peržiūros."

#: frappe/public/js/frappe/ui/permission_dialog.js:56
msgid "Allows the user to export document data from the system."
msgstr "Leidžia vartotojui eksportuoti dokumento duomenis iš sistemos."

#: frappe/public/js/frappe/ui/permission_dialog.js:70
msgid "Allows the user to print or download the document as a PDF."
msgstr "Leidžia vartotojui išspausdinti dokumentą arba atsisiųsti jį PDF formatu."

#: frappe/core/page/permission_manager/permission_manager_help.html:27
msgid "Allows the user to search and see records."
msgstr "Leidžia vartotojui ieškoti ir peržiūrėti įrašus."

#: frappe/public/js/frappe/ui/permission_dialog.js:35
msgid "Allows the user to search and select records in other forms. This does not allow the user to view the record itself."
msgstr "Leidžia vartotojui ieškoti ir pasirinkti įrašus kitose formose. Tačiau tai neleidžia vartotojui peržiūrėti paties įrašo."

#: frappe/public/js/frappe/ui/permission_dialog.js:74
msgid "Allows the user to send emails linked to the document."
msgstr "Leidžia vartotojui siųsti su dokumentu susietus el. laiškus."

#: frappe/public/js/frappe/ui/permission_dialog.js:64
msgid "Allows the user to share document access with other users who may not have access to the document themselves."
msgstr "Leidžia vartotojui suteikti prieigą prie dokumento kitiems vartotojams, kurie patys gali neturėti prieigos prie šio dokumento."

#: frappe/public/js/frappe/ui/permission_dialog.js:26
msgid "Allows the user to submit documents."
msgstr "Leidžia vartotojui pateikti dokumentus."

#: frappe/core/page/permission_manager/permission_manager_help.html:72
msgid "Allows the user to use Data Import tool to create / update records."
msgstr "Leidžia vartotojui naudoti duomenų importo įrankį įrašams kurti / atnaujinti."

#: frappe/public/js/frappe/ui/permission_dialog.js:60
msgid "Allows the user to use import documents into the system."
msgstr "Leidžia vartotojui importuoti dokumentus į sistemą."

#: frappe/core/page/permission_manager/permission_manager_help.html:32
#: frappe/public/js/frappe/ui/permission_dialog.js:17
msgid "Allows the user to view the document."
msgstr "Leidžia vartotojui peržiūrėti dokumentą."

