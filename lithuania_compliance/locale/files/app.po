msgstr "Importuojamas banko išrašas..."

msgid "No response from server."
msgstr "Nėra atsakymo iš serverio."

msgid "Created Payment Entries"
msgstr "Sukurti mokėjimo įrašai"

msgid "Import Errors"
msgstr "Importo klaidos"

msgid "Nothing was imported."
msgstr "Nieko nebuvo importuota."

msgid "Could not read file."
msgstr "Nepavyko perskaityti failo."

msgid "Upload an ISO_XML_052 (ISO 20022 CAMT052) bank statement file to create Bank Transactions and possibly Payment Entries."
msgstr "Įkelkite ISO_XML_052 (ISO 20022 CAMT052) banko išrašo failą, kad sukurtumėte banko operacijas ir galbūt mokėjimo įrašus."

msgid "Optional note about this import"
msgstr "Pasirinktinė pastaba apie šį importą"

msgid "Submit created Payment Entries"
msgstr "Pateikti sukurtus mokėjimo įrašus"

msgid "If not checked, created Payment Entries will remain in Draft state."
msgstr "Jei nepažymėta, sukurti mokėjimo įrašai liks juodraščio būsenoje."

msgid "Import Bank Statement"
msgstr "Importuoti banko išrašą"
