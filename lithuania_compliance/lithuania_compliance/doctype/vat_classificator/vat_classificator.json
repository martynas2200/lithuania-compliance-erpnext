{
  "doctype": "DocType",
  "name": "VAT Classificator",
  "module": "Lithuania Compliance",
  "custom": 0,
  "istable": 0,
  "editable_grid": 0,
  "quick_entry": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "is_submittable": 0,
  "engine": "InnoDB",
  "autoname": "field:code",
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": [
    "code",
    "is_exempt",
    "rate",
    "description"
  ],
  "fields": [
    {
      "fieldname": "code",
      "fieldtype": "Data",
      "label": "Code",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "is_exempt",
      "fieldtype": "Check",
      "label": "Exempt from VAT",
      "in_list_view": 1
    },
    {
      "fieldname": "rate",
      "fieldtype": "Float",
      "label": "Rate (%)",
      "in_standard_filter": 1,
      "depends_on": "eval: !doc.is_exempt"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "share": 1,
      "print": 1,
      "email": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Accounts Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "share": 1,
      "print": 1,
      "email": 1,
      "report": 1,
      "export": 1
    }
  ]
}
