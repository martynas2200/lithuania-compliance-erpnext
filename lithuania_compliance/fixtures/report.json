  "query": "SELECT\n    i.item_name,\n    b.item_code,\n    b.actual_qty,\n    i.item_group,\n    CASE\n        WHEN COALESCE(o.outgoing_7d, 0) > 0 THEN\n            CONCAT(\n                '<span style=\"color:red\"><div style=\"text-align:right\">',\n                ROUND(o.outgoing_7d, 3),\n                '</div></span>'\n            )\n        ELSE ''\n    END AS outgoing_7d,\n    rp.price_list_rate,\n    i.last_purchase_rate,\n    rp.barcode\n\nFROM `tabBin` b\n\nINNER JOIN `tabItem` i\n    ON i.name = b.item_code\n    AND i.disabled = 0\n\nINNER JOIN `tabItem Supplier` s\n    ON s.parent = b.item_code\n    AND s.supplier = %(supplier)s\n\nLEFT JOIN (\n    SELECT\n        item_code,\n        warehouse,\n        ABS(SUM(actual_qty)) AS outgoing_7d\n    FROM `tabStock Ledger Entry`\n    WHERE\n        actual_qty < 0\n        AND posting_date >= DATE_SUB(CURDATE(), INTERVAL 7 DAY)\n    GROUP BY\n        item_code,\n        warehouse\n) o\n    ON o.item_code = b.item_code\n    AND o.warehouse = b.warehouse\n\nLEFT JOIN (\n    SELECT\n        ranked.item_code,\n        ranked.price_list_rate,\n        ranked.packing_unit,\n        ranked.barcode,\n        ranked.valid_from,\n        ranked.valid_upto\n    FROM (\n        SELECT\n            ip.item_code,\n            ip.price_list_rate,\n            ip.packing_unit,\n            ip.valid_from,\n            ip.valid_upto,\n            ib.barcode,\n            ROW_NUMBER() OVER (\n                PARTITION BY ip.item_code\n                ORDER BY ip.valid_from DESC, ip.modified DESC\n            ) AS rn\n        FROM `tabItem Price` ip\n        LEFT JOIN `tabItem Barcode` ib\n            ON ib.parent = ip.item_code\n        WHERE\n            ip.selling = 1\n            AND ip.valid_from <= CURDATE()\n            AND (\n                ip.valid_upto IS NULL\n                OR ip.valid_upto >= CURDATE()\n            )\n    ) ranked\n    WHERE ranked.rn = 1\n) rp\n    ON rp.item_code = b.item_code\n\nORDER BY\n    i.item_group,\n    i.item_name;",
