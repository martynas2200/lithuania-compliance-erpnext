  "html": "{%- set fmt = frappe.utils.fmt_money -%}\n{%- set company = frappe.get_doc(\"Company\", doc.company) -%}\n\n<div class=\"print-format\" style=\"font-size: 10pt; max-width: 80mm; margin: 0 auto;\">\n\n    <!-- HEADER -->\n    <div class=\"text-center\" style=\"margin-bottom: 8px;\">\n        <h3 style=\"margin: 0 0 3px 0; font-size: 13pt;\">{{ company.name }}</h3>\n        {% if company.registration_details %}\n            <div style=\"font-size: 9pt;\">{{ company.registration_details }}</div>\n        {% endif %}\n        {% if company.tax_id %}\n            <div style=\"font-size: 9pt;\">PVM: {{ company.tax_id }}</div>\n        {% endif %}\n        {% if company.address %}\n            <div style=\"font-size: 9pt;\">{{ company.address }}</div>\n        {% endif %}\n        <hr style=\"margin: 6px 0;\">\n        <h2 style=\"margin: 4px 0; font-size: 14pt;\">KVITO KOPIJA</h2>\n        <div style=\"font-size: 9pt;\">Serija ir numeris: <strong>{{ doc.name }}</strong></div>\n        <div style=\"font-size: 9pt;\">Data: {{ frappe.utils.formatdate(doc.posting_date) }}</div>\n        {% if doc.due_date %}\n            <div style=\"font-size: 9pt;\">Apmokėti iki: {{ frappe.utils.formatdate(doc.due_date) }}</div>\n        {% endif %}\n        {% if doc.is_return %}\n            <div style=\"font-size: 10pt; font-weight: bold; color: #c00;\">GRĄŽINIMO DOKUMENTAS</div>\n            {% if doc.return_against %}\n                <div style=\"font-size: 9pt;\">Grąžinama už: {{ doc.return_against }}</div>\n            {% endif %}\n        {% endif %}\n    </div>\n\n    <hr style=\"margin: 4px 0;\">\n\n    <!-- CUSTOMER INFO -->\n    <table style=\"width: 100%; font-size: 9pt; margin-bottom: 6px;\">\n        <tr>\n            <td style=\"width: 30%;\"><strong>Pirkėjas:</strong></td>\n            <td>{{ doc.customer_name or doc.customer }}</td>\n        </tr>\n        {% if doc.customer_tax_id %}\n        <tr>\n            <td><strong>PVM kodas:</strong></td>\n            <td>{{ doc.customer_tax_id }}</td>\n        </tr>\n        {% endif %}\n        {% if doc.customer_address_display %}\n        <tr>\n            <td><strong>Adresas:</strong></td>\n            <td style=\"white-space: pre-line;\">{{ doc.customer_address_display }}</td>\n        </tr>\n        {% endif %}\n    </table>\n\n    <hr style=\"margin: 4px 0;\">\n\n    <!-- ITEMS TABLE -->\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 9pt;\">\n        <thead>\n            <tr style=\"border-bottom: 1px solid #000;\">\n                <th style=\"padding: 2px 2px; text-align: left; width: 4%;\">Nr.</th>\n                <th style=\"padding: 2px 2px; text-align: left;\">Prekė / paslauga</th>\n                <th style=\"padding: 2px 2px; text-align: right; width: 8%;\">Kiekis</th>\n                <th style=\"padding: 2px 2px; text-align: right; width: 12%;\">Kaina</th>\n                <th style=\"padding: 2px 2px; text-align: right; width: 14%;\">Suma</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.items %}\n            <tr>\n                <td style=\"padding: 2px 2px; text-align: left;\">{{ row.idx }}</td>\n                <td style=\"padding: 2px 2px; text-align: left;\">\n                    {{ row.item_name or row.item_code }}\n                    {%- if row.description and row.description != row.item_name %}\n                        <br><span style=\"font-size: 8pt; color: #555;\">{{ row.description }}</span>\n                    {% endif %}\n                </td>\n                <td style=\"padding: 2px 2px; text-align: right;\">{{ row.qty | abs }}</td>\n                <td style=\"padding: 2px 2px; text-align: right;\">{{ fmt(row.rate | abs, currency=doc.currency) }}</td>\n                <td style=\"padding: 2px 2px; text-align: right;\">{{ fmt(row.amount | abs, currency=doc.currency) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <hr style=\"margin: 4px 0;\">\n\n    <!-- TOTALS -->\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 9pt;\">\n        <tr>\n            <td style=\"padding: 2px 4px; text-align: right; width: 60%;\">Suma be PVM:</td>\n            <td style=\"padding: 2px 4px; text-align: right; width: 40%;\">{{ fmt(doc.net_total | abs, currency=doc.currency) }}</td>\n        </tr>\n        {% if doc.taxes %}\n            {% for tax in doc.taxes %}\n            <tr>\n                <td style=\"padding: 2px 4px; text-align: right;\">\n                    {{ tax.description }}\n                    {%- if tax.rate %} ({{ tax.rate | abs }}%){% endif %}\n                </td>\n                <td style=\"padding: 2px 4px; text-align: right;\">{{ fmt(tax.tax_amount | abs, currency=doc.currency) }}</td>\n            </tr>\n            {% endfor %}\n        {% endif %}\n        <tr style=\"border-top: 1px solid #000; font-weight: bold;\">\n            <td style=\"padding: 3px 4px; text-align: right;\">Iš viso su PVM:</td>\n            <td style=\"padding: 3px 4px; text-align: right;\">{{ fmt(doc.grand_total | abs, currency=doc.currency) }}</td>\n        </tr>\n        {% if doc.outstanding_amount and doc.outstanding_amount != doc.grand_total %}\n        <tr>\n            <td style=\"padding: 2px 4px; text-align: right; font-weight: bold;\">Liko apmokėti:</td>\n            <td style=\"padding: 2px 4px; text-align: right; font-weight: bold;\">{{ fmt(doc.outstanding_amount | abs, currency=doc.currency) }}</td>\n        </tr>\n        {% endif %}\n        {% if doc.in_words %}\n        <tr>\n            <td style=\"padding: 2px 4px; text-align: right;\">Suma žodžiais:</td>\n            <td style=\"padding: 2px 4px; text-align: right; font-size: 8pt;\">{{ doc.in_words }}</td>\n        </tr>\n        {% endif %}\n    </table>\n\n    {% if doc.terms %}\n    <hr style=\"margin: 4px 0;\">\n    <div style=\"font-size: 8pt; white-space: pre-line;\">{{ doc.terms }}</div>\n    {% endif %}\n\n    {% if doc.remarks %}\n    <hr style=\"margin: 4px 0;\">\n    <div style=\"font-size: 8pt; white-space: pre-line;\">{{ doc.remarks }}</div>\n    {% endif %}\n\n    <hr style=\"margin: 6px 0;\">\n\n    <!-- PAYMENTS -->\n    {% if doc.payments %}\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 9pt;\">\n        <thead>\n            <tr style=\"border-bottom: 1px solid #000;\">\n                <th style=\"padding: 2px 4px; text-align: left;\">Apmokėjimo būdas</th>\n                <th style=\"padding: 2px 4px; text-align: right;\">Suma</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for p in doc.payments %}\n            <tr>\n                <td style=\"padding: 2px 4px;\">{{ p.mode_of_payment }}</td>\n                <td style=\"padding: 2px 4px; text-align: right;\">{{ fmt(p.amount | abs, currency=doc.currency) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    <hr style=\"margin: 6px 0;\">\n    {% endif %}\n\n    <!-- FOOTER -->\n    <table style=\"width: 100%; font-size: 9pt; margin-top: 4px;\">\n        <tr>\n            <td style=\"text-align: center; padding-top: 20px;\">\n                <div style=\"border-top: 1px solid #000; display: inline-block; padding: 0 30px;\">Atsakingas asmuo</div>\n            </td>\n        </tr>\n    </table>\n\n    <div class=\"text-center\" style=\"margin-top: 10px; font-size: 8pt; color: #888;\">\n        {{ frappe.utils.formatdate(frappe.utils.nowdate()) }}\n    </div>\n\n</div>",
