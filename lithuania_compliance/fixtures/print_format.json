  "css": "@page { margin: 5mm; }\n.print-format { padding: 0 !important; font-size: 13pt; line-height: 1.2; }\nh3 { font-size: 16pt; margin: 0 0 2px 0; }\n.report-header { margin-bottom: 3px; }\ntable { width: 100%; border-collapse: collapse; }\n.print-format th { background-color: #f5f5f5; text-align: left; padding: 2px 3px !important; border-bottom: 1px solid #333; font-size: 12pt; white-space: nowrap; }\n.print-format td { padding: 2px 3px !important; border-bottom: none; vertical-align: top; line-height: 1.0; }\n.print-format tr:nth-child(even) td { background-color: #fafafa; }\n.print-format .text-right { text-align: right; }\n.print-format .text-center { text-align: center; }\n.print-format .text-nowrap { white-space: nowrap; }\n.print-format .barcode-col { font-family: Courier New, monospace; font-size: 11pt; }",
