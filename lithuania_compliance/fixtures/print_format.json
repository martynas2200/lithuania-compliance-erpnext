  "font_size": 14,
  "format_data": null,
  "html": "<div class=\"report-header\">\n        <h3>Atsargos pagal tiekėją</h3>\n        {% if filters && filters.supplier %}\n        <div><strong>Tiekėjas:</strong> {{ filters.supplier }}</div>\n        {% endif %}\n    </div>\n\n    <table>\n        <thead>\n            <tr>\n                <th style=\"width:28%;\">Prekė</th>\n                <th style=\"width:8%;text-align:right;\">Likutis</th>\n                <th style=\"width:10%;text-align:right;\">Per 7 d. parduota</th>\n                <th style=\"width:9%;text-align:right;\">Kaina</th>\n                <th style=\"width:9%;text-align:right;\">Savikaina</th>\n                <th style=\"width:14%;\">Barkodas</th>\n                <th style=\"width:8%;\">Kodas</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in data %}\n            <tr>\n                <td>{{ row.item_name }}</td>\n                <td class=\"text-right\">{{ row.actual_qty }}</td>\n                <td class=\"text-right\">{{ row.outgoing_7d }}</td>\n                <td class=\"text-right text-nowrap\">{{ row.price_list_rate }}</td>\n                <td class=\"text-right text-nowrap\">{{ row.last_purchase_rate }}</td>\n                <td class=\"barcode-col\">{{ row.barcode }}</td>\n                <td class=\"text-nowrap\">{{ row.item_code }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>",
