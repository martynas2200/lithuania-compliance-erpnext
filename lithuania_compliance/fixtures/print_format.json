  "html": "{%- set fmt = frappe.utils.fmt_money -%}\n{%- set company = frappe.get_doc(\"Company\", doc.company) -%}\n\n<div class=\"print-format\">\n\n    <!-- HEADER -->\n    <div class=\"row\">\n        <div class=\"col-xs-6\">\n            <h3 style=\"margin: 0 0 5px 0;\">{{ company.name }}</h3>\n            {% if company.registration_details %}\n                <div>{{ company.registration_details }}</div>\n            {% endif %}\n            {% if company.tax_id %}\n                <div>Įmonės kodas / PVM kodas: {{ company.tax_id }}</div>\n            {% endif %}\n            {% if company.address %}\n                <div>{{ company.address }}</div>\n            {% endif %}\n        </div>\n\n        <div class=\"col-xs-6 text-right\">\n            <h2 style=\"margin: 0 0 5px 0;\">Debetinė PVM sąskaita</h2>\n            {% if doc.is_return %}\n                <div><strong>Grąžinimo dokumentas</strong></div>\n                {% if doc.return_against %}\n                    <div>Grąžinama už sąskaitą: {{ doc.return_against }}</div>\n                {% endif %}\n            {% endif %}\n            <div>Serija ir numeris: <strong>{{ doc.name }}</strong></div>\n            <div>Data: {{ frappe.utils.formatdate(doc.posting_date) }}</div>\n            {% if doc.due_date %}\n                <div>Apmokėti iki: {{ frappe.utils.formatdate(doc.due_date) }}</div>\n            {% endif %}\n            {% if doc.bill_no %}\n                <div>Tiekėjo sąskaitos Nr.: {{ doc.bill_no }}</div>\n            {% endif %}\n        </div>\n    </div>\n\n    <hr>\n\n    <!-- SUPPLIER / CUSTOMER INFO -->\n    <div class=\"row\" style=\"margin-bottom: 10px;\">\n        <div class=\"col-xs-6\">\n            <h4>Tiekėjas</h4>\n            <div><strong>{{ doc.supplier_name or doc.supplier }}</strong></div>\n            {% if doc.supplier_tax_id %}\n                <div>PVM kodas: {{ doc.supplier_tax_id }}</div>\n            {% endif %}\n            {% if doc.supplier_address_display %}\n                <div style=\"white-space: pre-line;\">{{ doc.supplier_address_display }}</div>\n            {% endif %}\n        </div>\n\n        <div class=\"col-xs-6\">\n            <h4>Pirkėjas</h4>\n            <div><strong>{{ doc.company }}</strong></div>\n            {% if company.tax_id %}\n                <div>PVM kodas: {{ company.tax_id }}</div>\n            {% endif %}\n            {% if doc.company_address_display %}\n                <div style=\"white-space: pre-line;\">{{ doc.company_address_display }}</div>\n            {% endif %}\n        </div>\n    </div>\n\n    <!-- ITEMS TABLE -->\n    <table class=\"table table-bordered\">\n        <thead>\n            <tr>\n                <th style=\"width: 5%;\">Nr.</th>\n                <th>Prekė / paslauga</th>\n                <th style=\"width: 10%;\" class=\"text-right\">Kiekis</th>\n                <th style=\"width: 10%;\" class=\"text-right\">Mato vnt.</th>\n                <th style=\"width: 15%;\" class=\"text-right\">Kaina</th>\n                <th style=\"width: 15%;\" class=\"text-right\">Suma be PVM</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.items %}\n                <tr>\n                    <td>{{ row.idx }}</td>\n                    <td>\n                        {{ row.item_name or row.item_code }}\n                        {% if row.description and row.description != row.item_name %}\n                            <br><span style=\"font-size: 90%;\">{{ row.description }}</span>\n                        {% endif %}\n                    </td>\n                    <td class=\"text-right\">\n                        {{ row.qty | abs }}\n                    </td>\n                    <td class=\"text-right\">\n                        {{ row.uom }}\n                    </td>\n                    <td class=\"text-right\">\n                        {{ fmt(row.rate | abs, currency=doc.currency) }}\n                    </td>\n                    <td class=\"text-right\">\n                        {{ fmt(row.amount | abs, currency=doc.currency) }}\n                    </td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <!-- TOTALS AND TAXES -->\n    <div class=\"row\" style=\"margin-top: 10px;\">\n        <div class=\"col-xs-6\">\n            {% if doc.remarks %}\n                <h4>Pastabos</h4>\n                <div style=\"white-space: pre-line;\">{{ doc.remarks }}</div>\n            {% endif %}\n        </div>\n\n        <div class=\"col-xs-6\">\n            <table class=\"table table-condensed\">\n                <tbody>\n                    <tr>\n                        <td class=\"text-right\"><strong>Suma be PVM:</strong></td>\n                        <td class=\"text-right\">\n                            {{ fmt(doc.net_total | abs, currency=doc.currency) }}\n                        </td>\n                    </tr>\n\n                    {% if doc.taxes %}\n                        {% for tax in doc.taxes %}\n                            <tr>\n                                <td class=\"text-right\">\n                                    {{ tax.description }}\n                                    {% if tax.rate %}\n                                        ({{ tax.rate | abs }} %)\n                                    {% endif %}\n                                </td>\n                                <td class=\"text-right\">\n                                    {{ fmt(tax.tax_amount | abs, currency=doc.currency) }}\n                                </td>\n                            </tr>\n                        {% endfor %}\n                    {% endif %}\n\n                    <tr>\n                        <td class=\"text-right\"><strong>Iš viso su PVM:</strong></td>\n                        <td class=\"text-right\">\n                            <strong>{{ fmt(doc.grand_total | abs, currency=doc.currency) }}</strong>\n                        </td>\n                    </tr>\n\n                    {% if doc.in_words %}\n                        <tr>\n                            <td class=\"text-right\"><strong>Suma žodžiais:</strong></td>\n                            <td class=\"text-right\">{{ doc.in_words }}</td>\n                        </tr>\n                    {% endif %}\n                </tbody>\n            </table>\n        </div>\n    </div>\n\n    <!-- FOOTER / SIGNATURES -->\n    <div style=\"margin-top: 30px;\">\n        <div class=\"row\">\n            <div class=\"col-xs-6\">\n                <div>Atsakingas asmuo:</div>\n                <div style=\"margin-top: 30px; border-top: 1px solid #000; width: 80%;\"></div>\n            </div>\n            <div class=\"col-xs-6\">\n                <div>Tiekėjo parašas:</div>\n                <div style=\"margin-top: 30px; border-top: 1px solid #000; width: 80%;\"></div>\n            </div>\n        </div>\n    </div>\n\n</div>",
